# Copie para .env (nunca commite o .env).

# Obrigatório: assina o cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Alertas no Telegram (opcional). Crie um bot com o @BotFather e pegue o chat id
# enviando uma mensagem ao bot e abrindo https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Administrador inicial (opcional: sem isso, o painel pede o cadastro no primeiro acesso)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Outros
# UPTRUE_PORT=3000
# RETENTION_DAYS=90
# CHECK_CONCURRENCY=10
