# Copie para .env (nunca commite o .env).

# Obrigatório: assina o cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Alertas no Telegram (opcional). Crie um bot com o @BotFather e pegue o chat id
# enviando uma mensagem ao bot e abrindo https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Administrador inicial (opcional: sem isso, o painel pede o cadastro no primeiro acesso)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Página de status pública em /status (marque os sites como "públicos" no painel)
# STATUS_PAGE_TITLE=Status dos serviços

# Métricas para o Prometheus em /metrics (desligado sem token). Gere como o AUTH_SECRET.
METRICS_TOKEN=

# Perfil de observabilidade: scripts/observability.sh init gera os segredos que faltarem
# e scripts/observability.sh up sobe a pilha (ou: docker compose --profile observability up -d)
# Exige também METRICS_TOKEN (acima). O Grafana abre em http://localhost:3001 (só nesta máquina).
GRAFANA_ADMIN_PASSWORD=
# GRAFANA_PORT=3001
# GRAFANA_BIND=127.0.0.1
# PROMETHEUS_RETENTION=15d

# Nome que aparece na capa dos relatórios em PDF (ex.: seu nome ou da sua empresa)
# REPORT_AUTHOR=

# Outros
# UIVO_PORT=3000
# RETENTION_DAYS=90
# CHECK_CONCURRENCY=10
